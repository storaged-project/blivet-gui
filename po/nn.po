msgstr "slett partisjon {name}"

#: ../blivetgui/blivetgui.py:680
msgid "Failed to perform the actions:"
msgstr "Klarte ikkje utføre handlingane:"

#: ../blivetgui/blivetgui.py:724
msgid "Confirm scheduled actions"
msgstr "Stadfest planlagde handlingar"

#: ../blivetgui/blivetgui.py:725
msgid "Are you sure you want to perform scheduled actions?"
msgstr "Vil du verkeleg utføre dei planlagde handlingane?"

#: ../blivetgui/blivetgui.py:766
#, python-brace-format
msgid ""
"Unmount of '{mountpoint}' failed. Are you sure the device is not in use?"
msgstr ""
"Avmontering av '{mountpoint}' mislukkast. Er du sikker på at eininga ikkje "
"er i bruk?"

#: ../blivetgui/blivetgui.py:788
msgid "Unlocking failed. Are you sure provided password is correct?"
msgstr ""
"Opplåsinga mislukkast. Er du sikker på at passfrasen du oppgav, er rett?"

#: ../blivetgui/blivetgui.py:838 ../data/ui/blivet-gui.ui:708
msgid "Quit"
msgstr "Avslutt"

#: ../blivetgui/blivetgui.py:841
msgid "blivet-gui is already running"
msgstr "blivet-gui køyrer allereie"

#: ../blivetgui/blivetgui.py:842
msgid ""
"Another instance of blivet-gui is already running.\n"
"Only one instance of blivet-gui can run at the same time."
msgstr ""
"Ein annan instans av blivet-gui køyrer allereie.\n"
"Berre éin instans av blivet-gui kan køyre samtidig."

#: ../blivetgui/blivetgui.py:844
msgid ""
"If your previous instance of blivet-gui crashed, please make sure that the "
"<i>blivet-gui-daemon</i> process was terminated too.\n"
"If it is still running you can use\n"
"\n"
"<tt>$ sudo killall blivet-gui-daemon</tt>\n"
"\n"
"command to force quit it."
msgstr ""
"Viss den førre instansen av blivet-gui krasja, må du sørgje for at prosessen "
"<i>blivet-gui-daemon</i> òg vart avslutta.\n"
"Viss han framleis køyrer, kan du bruke kommandoen\n"
"\n"
"<tt>$ sudo killall blivet-gui-daemon</tt>\n"
"\n"
"for å tvinge han til å avslutte."

#: ../blivetgui/blivetgui.py:876
msgid "Failed to init blivet:"
msgstr "Klarte ikkje starte blivet:"

#: ../blivetgui/blivetgui.py:883
msgid "Quit blivet-gui"
msgstr "Avslutt blivet-gui"

#: ../blivetgui/blivetgui.py:885
msgid "Ignore disk and continue"
msgstr "Ignorer disk og hald fram"

#: ../blivetgui/blivetgui.py:888
#, python-brace-format
msgid "Error: {error}"
msgstr "Feil: {error}"

#: ../blivetgui/blivetgui.py:889
#, python-brace-format
msgid ""
"Blivet-gui can't use the <b>{name}</b> disk due to a corrupted/unknown "
"disklabel.\n"
"You can either quit blivet-gui now or continue without being able to use "
"this disk."
msgstr ""
"Blivet-gui kan ikkje bruke disken <b>{name}</b> på grunn av ein øydelagd "
"eller ukjend disketikett.\n"
"Du kan anten avslutte blivet-gui no eller halde fram utan å kunne bruke "
"denne disken."

#: ../blivetgui/blivetgui.py:925
msgid "Confirm reload storage"
msgstr "Stadfest oppdatering av lagringa"

#: ../blivetgui/blivetgui.py:926
msgid "There are pending operations. Are you sure you want to continue?"
msgstr "Det finst ventande operasjonar. Er du sikker på at du vil halde fram?"

#: ../blivetgui/blivetgui.py:957
msgid "Are you sure you want to quit?"
msgstr "Er du sikker på at du vil avslutte?"

#: ../blivetgui/blivetgui.py:958
msgid ""
"There are pending operations. Are you sure you want to quit blivet-gui now?"
msgstr ""
"Det finst ventande operasjonar. Er du sikker på at du vil avslutte blivet-"
"gui no?"

#: ../blivetgui/blivet_utils.py:79
msgid "free space"
msgstr "ledig plass"

#: ../blivetgui/blivet_utils.py:701
#, python-brace-format
msgid "Resizing of {type} devices is currently not supported"
msgstr "Det er førebels ikkje støtta å endre storleiken på {type}-einingar"

#: ../blivetgui/blivet_utils.py:706
msgid "Protected devices cannot be resized"
msgstr "Verna einingar kan ikkje endrast i storleik"

#: ../blivetgui/blivet_utils.py:711
msgid "Immutable formats cannot be resized"
msgstr "Uforanderlege format kan ikkje endrast i storleik"

#: ../blivetgui/blivet_utils.py:716
msgid "Devices with children cannot be resized"
msgstr "Einingar med underordna einingar kan ikkje endrast i storleik"

#: ../blivetgui/blivet_utils.py:727
msgid "Unformatted devices are not resizable"
msgstr "Uformaterte einingar kan ikkje endrast i storleik"

#. unfortunately we can't use format._resizable here because blivet uses it to both mark
#. formats as not resizable and force users to call update_size_info on resizable formats
#: ../blivetgui/blivet_utils.py:734
#, python-brace-format
msgid "Resizing of {type} format is currently not supported"
msgstr ""
"Det er førebels ikkje støtta å endre storleiken på format av typen {type}"

#: ../blivetgui/blivet_utils.py:739
#, python-brace-format
msgid "Tools for resizing format {type} are not available."
msgstr ""
"Verktøy for å endre storleiken på formatet {type} er ikkje tilgjengelege."

#. TODO: we could support this by simply changing formats target size but we'd need
#. a workaround for the missing action
#: ../blivetgui/blivet_utils.py:746
msgid "Formats scheduled to be created cannot be resized"
msgstr "Format som er planlagde oppretta, kan ikkje endrast i storleik"

#: ../blivetgui/blivet_utils.py:751
#, python-brace-format
msgid "Format {type} doesn't support updating its size limit information"
msgstr ""
"Formatet {type} støttar ikkje oppdatering av informasjonen om "
"storleiksgrenser"

#: ../blivetgui/blivet_utils.py:758
msgid "Mounted devices cannot be resized"
msgstr "Monterte einingar kan ikkje endrast i storleik"

#: ../blivetgui/blivet_utils.py:763
msgid "Logical Volumes with snapshots cannot be resized."
msgstr "Logiske volum med augneblinksbilete kan ikkje endrast i storleik."

#: ../blivetgui/blivet_utils.py:768
msgid "Resizing of LUKS2 devices is currently not supported."
msgstr "Det er førebels ikkje støtta å endre storleiken på LUKS2-einingar."

#: ../blivetgui/blivet_utils.py:780
#, python-brace-format
msgid "Failed to update filesystem size info: {error}"
msgstr "Klarte ikkje oppdatere storleiksinformasjon for filsystemet: {error}"

#: ../blivetgui/blivet_utils.py:799
msgid "Device is not resizable."
msgstr "Eininga kan ikkje endrast i storleik."

#: ../blivetgui/blivet_utils.py:801
msgid "Format is not resizable after updating its size limit information."
msgstr ""
"Formatet kan ikkje endrast i storleik etter at informasjonen om "
"storleiksgrenser er oppdatert."

