#: ../blivetgui/blivetgui.py:479
#, python-brace-format
msgid ""
"{name} is not complete. It is not possible to add new LVs to VG with missing "
"PVs."
msgstr ""
"{name} er ikkje fullstendig. Det er ikkje mogleg å leggje til nye LV-ar i VG "
"med manglande PV-ar."

#: ../blivetgui/blivetgui.py:484
msgid "Not enough free space for a new LVM Volume Group."
msgstr "Ikkje nok ledig plass for ei ny LVM-volumgruppe."

#: ../blivetgui/blivetgui.py:490
#, python-brace-format
msgid ""
"Disk {name} already reached maximum allowed number of primary partitions for "
"{label} disklabel."
msgstr ""
"Disken {name} har alt nådd det største tillatne talet på primærpartisjonar "
"for disketiketten {label}."

