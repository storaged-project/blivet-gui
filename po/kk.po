msgid "free space"
msgstr "бос орын"

#: ../blivetgui/blivet_utils.py:704
#, python-brace-format
msgid "Resizing of {type} devices is currently not supported"
msgstr ""
"{type} құрылғыларының өлшемін өзгертуге қазіргі уақытта қолдау көрсетілмейді"

#: ../blivetgui/blivet_utils.py:709
msgid "Protected devices cannot be resized"
msgstr "Қорғалған құрылғылардың өлшемін өзгерту мүмкін емес"

#: ../blivetgui/blivet_utils.py:714
msgid "Immutable formats cannot be resized"
msgstr "Өзгермейтін пішімдердің өлшемін өзгерту мүмкін емес"

#: ../blivetgui/blivet_utils.py:719
msgid "Devices with children cannot be resized"
msgstr "Ішкі элементтері бар құрылғылардың өлшемін өзгерту мүмкін емес"

#: ../blivetgui/blivet_utils.py:730
msgid "Unformatted devices are not resizable"
msgstr "Пішімделмеген құрылғылардың өлшемін өзгерту мүмкін емес"

#. unfortunately we can't use format._resizable here because blivet uses it to both mark
#. formats as not resizable and force users to call update_size_info on resizable formats
#: ../blivetgui/blivet_utils.py:737
#, python-brace-format
msgid "Resizing of {type} format is currently not supported"
msgstr ""
"{type} пішімінің өлшемін өзгертуге қазіргі уақытта қолдау көрсетілмейді"

#: ../blivetgui/blivet_utils.py:742
#, python-brace-format
msgid "Tools for resizing format {type} are not available."
msgstr "{type} пішімінің өлшемін өзгертуге арналған саймандар қолжетімді емес."

#. TODO: we could support this by simply changing formats target size but we'd need
#. a workaround for the missing action
#: ../blivetgui/blivet_utils.py:749
msgid "Formats scheduled to be created cannot be resized"
msgstr "Жасалуы жоспарланған пішімдердің өлшемін өзгерту мүмкін емес"

#: ../blivetgui/blivet_utils.py:754
#, python-brace-format
msgid "Format {type} doesn't support updating its size limit information"
msgstr "{type} пішімі өзінің өлшем шегі туралы ақпаратты жаңартуды қолдамайды"

#: ../blivetgui/blivet_utils.py:761
msgid "Mounted devices cannot be resized"
msgstr "Тіркелген құрылғылардың өлшемін өзгерту мүмкін емес"

#: ../blivetgui/blivet_utils.py:766
msgid "Logical Volumes with snapshots cannot be resized."
msgstr "Снапшоттары бар логикалық томдардың өлшемін өзгерту мүмкін емес."

#: ../blivetgui/blivet_utils.py:771
msgid "Resizing of LUKS2 devices is currently not supported."
msgstr ""
"LUKS2 құрылғыларының өлшемін өзгертуге қазіргі уақытта қолдау көрсетілмейді."

#: ../blivetgui/blivet_utils.py:783
#, python-brace-format
msgid "Failed to update filesystem size info: {error}"
msgstr "Файлдық жүйе өлшемі туралы ақпаратты жаңарту сәтсіз аяқталды: {error}"

#: ../blivetgui/blivet_utils.py:802
msgid "Device is not resizable."
msgstr "Құрылғының өлшемін өзгерту мүмкін емес."

#: ../blivetgui/blivet_utils.py:804
msgid "Format is not resizable after updating its size limit information."
msgstr ""
"Өлшем шегі туралы ақпаратты жаңартқаннан кейін пішімнің өлшемін өзгерту "
"мүмкін емес."

